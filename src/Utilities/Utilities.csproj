<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <Title>Lopah Library Utilities</Title>
        <Authors>Lopah (Daniel Jašek)</Authors>
        <RepositoryType>private</RepositoryType>
        <PackageTags>Lopah, Library, Utilities</PackageTags>
        <IsPackable>true</IsPackable>
        <PackageId>Lopah.AspNetCore.Utilities</PackageId>
        <RepositoryUrl>https://git.lopah.eu/lopah/Library</RepositoryUrl>
        <PackageReleaseNotes>Created Utilities extensions for easier work</PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Humanizer.Core" Version="3.0.10"/>
        <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" />
    </ItemGroup>

</Project>
